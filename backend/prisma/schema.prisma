// Prisma Schema for WeCode Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
  FACULTY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  CPP
  PYTHON
  JAVA
}

enum SubmissionStatus {
  PENDING
  COMPILING
  RUNNING
  COMPLETED
}

enum Verdict {
  QUEUED
  COMPILING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  SYSTEM_ERROR
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  fullName     String       @map("full_name") @db.VarChar(100)
  role         Role         @default(STUDENT)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdProblems Problem[]
  submissions     Submission[]

  @@map("users")
}

model Problem {
  id                  String       @id @default(uuid())
  slug                String       @unique @db.VarChar(100)
  title               String       @db.VarChar(200)
  descriptionMarkdown String       @map("description_markdown") @db.Text
  difficulty          Difficulty   @default(EASY)
  timeLimitMs         Int          @default(2000) @map("time_limit_ms")
  memoryLimitMb       Int          @default(256) @map("memory_limit_mb")
  isPublished         Boolean      @default(false) @map("is_published")
  createdById         String       @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  createdBy           User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  problemTags         ProblemTag[]
  testCases           TestCase[]
  submissions         Submission[]

  @@index([isPublished, difficulty])
  @@map("problems")
}

model Tag {
  id          String       @id @default(uuid())
  name        String       @unique @db.VarChar(50)
  slug        String       @unique @db.VarChar(50)
  problemTags ProblemTag[]

  @@map("tags")
}

model ProblemTag {
  problemId String   @map("problem_id")
  tagId     String   @map("tag_id")

  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tags")
}

model TestCase {
  id                String             @id @default(uuid())
  problemId         String             @map("problem_id")
  inputData         String             @map("input_data") @db.Text
  expectedOutput    String             @map("expected_output") @db.Text
  isSample          Boolean            @default(false) @map("is_sample")
  points            Int                @default(10)
  orderIndex        Int                @default(0) @map("order_index")
  createdAt         DateTime           @default(now()) @map("created_at")

  problem           Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionResults SubmissionResult[]

  @@index([problemId, isSample])
  @@map("test_cases")
}

model Submission {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  problemId       String             @map("problem_id")
  language        Language           @default(CPP)
  code            String             @db.Text
  status          SubmissionStatus   @default(PENDING)
  verdict         Verdict            @default(QUEUED)
  executionTimeMs Int?               @map("execution_time_ms")
  memoryKb        Int?               @map("memory_kb")
  errorMessage    String?            @map("error_message") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem         Problem            @relation(fields: [problemId], references: [id], onDelete: Restrict)
  results         SubmissionResult[]

  @@index([userId, problemId, createdAt])
  @@index([problemId, verdict])
  @@map("submissions")
}

model SubmissionResult {
  id              String      @id @default(uuid())
  submissionId    String      @map("submission_id")
  testCaseId      String      @map("test_case_id")
  verdict         Verdict
  executionTimeMs Int         @map("execution_time_ms")
  memoryKb        Int         @map("memory_kb")
  stdout          String?     @db.Text
  stderr          String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")

  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase        TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@map("submission_results")
}
